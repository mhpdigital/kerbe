{% extends 'base.html.twig' %}

{% block body %}
<h1>Cards</h1>
<div class="card-grid">
    {% for card in cards %}
        <a class="card card-hover" href="{{ path('card_detail', {id: card.id}) }}">
            <img src="{{ card.cover }}" alt="">
            <span class="card-title">{{ card.title }}</span>
        </a>
    {% endfor %}
</div>
{% endblock %}

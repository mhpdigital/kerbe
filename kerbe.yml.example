# kerbe.yml — project configuration for the kerbe skill suite.
# Copy to the project root as kerbe.yml and adjust. Skills hard-stop without it.
kerbe:
  planning_root: planning/slices          # slice folders live at {planning_root}/{slice}; registry at {planning_root}/INDEX.md
                                          #   may point outside the code repo, e.g. ../mgr-pm/planning/slices — the git repo
                                          #   containing it is the PLANNING REPO and planning commits run `git -C` there
  timezone: Pacific/Auckland              # local timezone for TIMING.md lifecycle stamps
  # editor_cmd: "phpstorm --line {line} {file}"
                                          # optional: per-finding open command for reviews ({file} is absolute);
                                          #   unset ⇒ reviews print clickable file:line references instead
  # editor_cmd_method: "phpstorm --line $(grep -n 'function {method}(' {file} | cut -d: -f1) {file}"
                                          # optional: method-anchored variant for review rows that name a method();
                                          #   resolves the line at run time so it survives line drift. Stack-specific
                                          #   (the grep above is PHP) — unset ⇒ every row uses editor_cmd
  # legacy_root: ../legacy-app            # optional: old system a slice may migrate from (enables IMPORT/CODEMAP docs)
  promise_sources:
    spec_globs: ["*.md"]                  # spec docs in the slice folder; classified by content, not filename
    plan_glob: "*PLAN*.md"                # the frozen task list; progress ledgers are never the plan
  design:
    adapter: figma                        # figma | claude-design | none
    # dir: design                         # claude-design only: *.dc.html artboards, relative to the slice folder
    cache_dir: design-cache               # figma only: snapshot dir, relative to the slice folder
    file_key: "<figma-file-key>"          # required for adapter: figma
    token_env: FIGMA_API_TOKEN            # env var holding the API token…
    # token_cmd: "aws ssm get-parameter --name /<project>/figma/api-token --with-decryption --query Parameter.Value --output text"
                                          # …or a shell command that prints it (token_env wins if both are set)
  stack:
    adapter: symfony                      # symfony | flutter
    code_roots: ["symfony/"]           # where the slice's implementation lives; may contain {slice}
    # exec: "docker exec <container> bash -c 'cd /var/www/html/symfony && {cmd}'"
                                          # optional wrapper for every adapter command ({cmd} is substituted).
                                          # With workspace.lanes > 1 it MUST carry {lane}, e.g.
                                          #   "docker exec <project>-{slice}-l{lane}-web-test-1 {cmd}"
  workspace:                              # where implementation happens (kerbe:implement, kerbe:bug)
    root: ~/projects                      # parent dir for slice worktrees; omit ⇒ no worktree is created and
                                          #   the resolved stack.code_roots entry IS the workspace
    prefix: <project>-                    # worktree path = {root}/{prefix}{slice}
    branch_prefix: slice/                 # feature branch = {branch_prefix}{slice}
    review_prefix: review/                # a {review_prefix}{slice} worktree supersedes the slice one
    base_branch: origin/review/main       # branch a fresh slice branch is cut from
    # planning_branch: review/planning     # ONLY when planning docs live in the code repo on another branch;
                                          #   omit when the planning root is its own repository
    progress_file: claude-progress.md     # live per-workspace tracker; never a hidden dotfolder
    setup_cmds: []                        # commands run once after creating a workspace (env/DB standup), e.g.
      # - "docker compose up -d"
    lanes: 1                              # isolated verification lanes per slice (worktree + its own env).
                                          #   1 ⇒ every lane-bound task runs in the workspace, one at a time.
                                          #   >1 REQUIRES {lane} in stack.exec, or every lane routes to the
                                          #   same environment and workers verify nothing.
    # worktree_setup_cmds:                 # run in EVERY fresh worktree, lane-bound or not. A fresh worktree
      # - "composer install --no-interaction"   #   has source and no vendor/, so without this even a unit-only
                                          #   worker cannot run its tests — unset ⇒ everything runs in lane 0.
    # lane_setup_cmds:                     # run once per lane >0 to stand up its own environment.
      # - "docker compose -p <project>-{slice}-l{lane} up -d"   # kerbe does no port/name arithmetic; this owns it
    # lane_teardown_cmds:                  # run at end of the slice run; lane 0 is never torn down
      # - "docker compose -p <project>-{slice}-l{lane} down -v"
  executor:
    adapter: claude                       # adapters/executor/<name>.md — how a task worker is dispatched
    routing: {}                           # optional task-class overrides, e.g. {business-logic: claude@standard}
  constraints: []                         # environment rules that hold for EVERY skill's dispatches, e.g.
    # - "never run a destructive database command"
  constraints_by_skill: {}                # rules that hold for ONE skill only, e.g.
    # coverage:
    #   - "do not modify application code or docs; this is a report-only review"
